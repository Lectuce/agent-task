       └──────┬──────┘                                         │
          是  │  否                                            │
              │   └────► Stop Hook ───► 最终回答               │
              ▼                                                │
       ┌─────────────────┐                                     │
       │ PreToolUse Hook │                                     │
       │ Permission + Log│                                     │
       └────────┬────────┘                                     │
                ▼                                              │
       ┌─────────────────┐                                     │
       │ handlers[name]  │                                     │
       └────────┬────────┘                                     │
         ┌──────┴───────────────┐                              │
         ▼                      ▼                              │
 ┌───────────────┐      ┌───────────────────┐                  │
 │普通工具/搜索  │      │ todo_write        │                  │
 └───────┬───────┘      │ CurrentTodos      │                  │
         │              │ pending/progress/ │                  │
         │              │ completed         │                  │
         │              └─────────┬─────────┘                  │
