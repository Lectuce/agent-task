        └──────────────┬───┴───────────────────┘
                       ▼
             ┌───────────────────┐
             │ GetSystemPrompt() │
             └─────────┬─────────┘
                       │ system
                       ▼
                   ┌──────────────────────────────────────────────────────┐
                   │                                                      │
                   ▼                                                      │
            ┌─────────────────┐                                           │
            │UserPromptSubmit │                                           │
            └────────┬────────┘                                           │
                     ▼                                                    │
            ┌─────────────────┐                                           │
            │ Todo Reminder ? │                                           │
            └────────┬────────┘                                           │
                     ▼                                                    │
            ┌─────────────┐                                               │
            │ messages[]  │                                               │
            └──────┬──────┘                                               │
                   ▼                                                      │
            ┌──────────────────┐                                          │
            │ToolResultBudget  │                                          │
            │last message only │                                          │
            └──────┬───────────┘                                          │
                   ▼                                                      │
            ┌──────────────────┐                                          │
            │ SnipCompact      │                                          │
            │ head 3 + tail 47 │                                          │
            └──────┬───────────┘                                          │
                   ▼                                                      │
            ┌──────────────────┐                                          │
