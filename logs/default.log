       │Todo Reminder ?  │                                     │
       │RoundsSinceTodo≥3│                                     │
       └────────┬────────┘                                     │
                ▼                                              │
       ┌─────────────┐      ┌──────────────────────────┐       │
       │ messages[]  │      │ BuildTools / Tool Schema │       │
       └──────┬──────┘      └────────────┬─────────────┘       │
              ▼                          │                     │
       ┌─────────────┐◄──────────────────┘                     │
       │     LLM     │                                         │
       └──────┬──────┘                                         │
              ▼                                                │
       ┌─────────────┐                                         │
       │ tool_use ?  │                                         │
       └──────┬──────┘                                         │
          是  │  否                                            │
              │   └────► Stop Hook ───► 最终回答               │
              ▼                                                │
       ┌─────────────────┐                                     │
       │ PreToolUse Hook │                                     │
       │ Permission + Log│                                     │
       └────────┬────────┘                                     │
                ▼                                              │
       ┌─────────────────┐                                     │
       │ handlers[name]  │                                     │
       └────────┬────────┘                                     │
         ┌──────┴───────────────┐                              │
         ▼                      ▼                              │
 ┌───────────────┐      ┌───────────────────┐                  │
 │普通工具/搜索  │      │ todo_write        │                  │
 └───────┬───────┘      │ CurrentTodos      │                  │
         │              │ pending/progress/ │                  │
         │              │ completed         │                  │
         │              └─────────┬─────────┘                  │
         └─────────────┬──────────┘                             │
                       ▼                                        │
              ┌─────────────────┐                               │
              │PostToolUse Hook │                               │
              └────────┬────────┘                               │
