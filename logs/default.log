       │ UserPromptSubmit    │
       │ contextInjectHook   │
       └──────────┬──────────┘
                  ▼
              ┌────────────────────────────────────────────┐
              │                                            │
              ▼                                            │
       ┌─────────────┐      ┌──────────────────────────┐   │
       │ messages[]  │      │ BuildTools / Tool Schema │   │
       └──────┬──────┘      └────────────┬─────────────┘   │
              ▼                          │                 │
       ┌─────────────┐◄──────────────────┘                 │
       │     LLM     │                                     │
       └──────┬──────┘                                     │
              ▼                                            │
       ┌─────────────┐                                     │
       │ tool_use ?  │                                     │
       └──────┬──────┘                                     │
          是  │  否                                        │
              │   └────► Stop Hook ───► 最终回答           │
              ▼                                            │
       ┌─────────────────┐                                 │
       │ Client ToolUse  │──否──► web_search / Provider    │
       └────────┬────────┘                                 │
                ▼                                          │
       ┌─────────────────┐                                 │
       │ PreToolUse Hook │                                 │
       │ Permission + Log│                                 │
       └────────┬────────┘                                 │
          allow │ blocked                                  │
          ┌─────┴──────────┐                               │
          ▼                ▼                               │
 ┌─────────────────┐ ┌─────────────────┐                   │
 │ handlers[name]  │ │error tool_result│                   │
 └────────┬────────┘ └────────┬────────┘                   │
          ▼                   │                            │
 ┌─────────────────┐          │                            │
 │PostToolUse Hook │          │                            │
 │largeOutputHook  │          │                            │
 └────────┬────────┘          │                            │
          └─────────┬─────────┘                            │
                    ▼                                      │
             ┌─────────────┐                               │
             │ tool_result │                               │
             └──────┬──────┘                               │
                    └───────────────────────────────────────┘
